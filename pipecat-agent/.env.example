# Soniox — one key powers both STT (stt-rt-v5) and TTS (tts-rt-v1).
SONIOX_API_KEY=your-soniox-key
# OpenRouter — serves Gemma-4 via the Cerebras provider (fast TTFT).
OPENROUTER_API_KEY=your-openrouter-key
# Optional: override the model to A/B latency, e.g. groq/llama-3.3-70b-versatile
# KAIRA_LLM=google/gemma-4-31b-it

# Voice pipeline: "cascade" (default: Soniox+Gemma+Soniox) or "ultravox" (full-duplex S2S).
# KAIRA_MODE=ultravox
# Ultravox Realtime (full-duplex S2S) — only needed when KAIRA_MODE=ultravox.
ULTRAVOX_API_KEY=your-ultravox-key

# ---- Nova's tools (view surface) ----
# Mapbox — places + static map + directions (search_places, get_directions). Public pk. token.
MAPBOX_TOKEN=pk.your-mapbox-token
# Tavily — web reader + image search (search_web, search_images).
TAVILY_API_KEY=tvly-your-tavily-key
# SerpApi — Google Shopping results (search_products).
SERPAPI_API_KEY=your-serpapi-key

# Fallback location for directions when the client can't report GPS (e.g. the emulator).
# Overridden by the phone's real GPS on a device. Example: Everett, WA.
# KAIRA_HOME_LAT=47.9790
# KAIRA_HOME_LNG=-122.2015
