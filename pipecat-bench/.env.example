# Kaira Pipecat benchmark -- copy to .env and fill in. NEVER commit .env.
# Only the keys for the providers you actually select below are required.

# ── Architecture ──────────────────────────────────────────────────────────
MODE=cascade                 # cascade (STT->LLM->TTS) | s2s (speech-to-speech)
GREETING_ENABLED=false       # false = clean benchmark (only bot RESPONSES make audio)
# SYSTEM_INSTRUCTION="You are Kaira ..."   # optional override; default handles ID+EN

# ── Cascade providers (MODE=cascade) ──────────────────────────────────────
STT_PROVIDER=deepgram        # deepgram | google | assemblyai
LLM_PROVIDER=openai          # openai | google
TTS_PROVIDER=cartesia        # cartesia | elevenlabs | google | deepgram

# ── Speech-to-speech provider (MODE=s2s) ──────────────────────────────────
S2S_PROVIDER=gemini          # gemini | openai

# ── API keys (set the ones your selection needs) ──────────────────────────
DEEPGRAM_API_KEY=            # STT default; also DeepgramTTS. https://console.deepgram.com
OPENAI_API_KEY=              # LLM default (gpt-4o) AND OpenAI Realtime s2s. https://platform.openai.com
CARTESIA_API_KEY=            # TTS default (low latency). https://play.cartesia.ai
ELEVENLABS_API_KEY=          # optional TTS (best Indonesian). https://elevenlabs.io
GOOGLE_API_KEY=              # Gemini Live s2s + Google LLM. https://aistudio.google.com/apikey
ASSEMBLYAI_API_KEY=          # optional STT. https://www.assemblyai.com

# Google Cloud STT/TTS (service-account JSON string) -- only for STT/TTS_PROVIDER=google
# GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ── Optional model / voice / language overrides ───────────────────────────
# DEEPGRAM_MODEL=nova-3          # nova-3 + DEEPGRAM_LANGUAGE=multi = EN-centric code-switch (NO Indonesian)
# DEEPGRAM_LANGUAGE=multi        # for real Indonesian use STT_PROVIDER=google, or nova-2 + language=id
# OPENAI_MODEL=gpt-4o
# CARTESIA_MODEL=sonic-2
# CARTESIA_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121
# CARTESIA_LANGUAGE=en
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# GOOGLE_STT_LANGUAGES=id-ID,en-US
# GOOGLE_STT_MODEL=chirp_2
# GOOGLE_TTS_VOICE=id-ID-Chirp3-HD-Aoede
# GOOGLE_MODEL=gemini-2.0-flash
# GEMINI_VOICE=Aoede

# ── Transport / server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=7860
STUN_URL=stun:stun.l.google.com:19302
# TURN relay -- REQUIRED for real mobile (carrier-grade NAT on Indonesian 3G). See README.
# TURN_URL=turn:your-turn-host:3478?transport=udp
# TURN_USERNAME=
# TURN_PASSWORD=
